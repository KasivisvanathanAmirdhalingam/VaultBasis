{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VaultBasis Golden Fixture Manifest",
  "description": "Declarative manifest for an executable assurance contract fixture.",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string",
      "description": "Unique identifier for this golden fixture (e.g. G001_exact_match)"
    },
    "layer": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "The validation layer this fixture belongs to (A=Canonical, B=Boundaries, C=Hostile, D=Verifier)"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "BLOCKED", "DEFERRED", "NONCONFORMING"],
      "description": "Execution status of the fixture"
    },
    "semantic_spec_version": {
      "type": "string",
      "description": "Version of the reconciliation semantics tested"
    },
    "evidence_contract_version": {
      "type": "string",
      "description": "Version of the output receipt schema tested"
    },
    "description": {
      "type": "string",
      "description": "Human-readable intent of the fixture"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "broker": {
          "type": "string",
          "description": "Filename of the broker input (e.g. broker.csv)"
        },
        "ledger": {
          "type": "string",
          "description": "Filename of the ledger input (e.g. ledger.csv)"
        }
      },
      "required": ["broker", "ledger"]
    },
    "expected": {
      "type": "object",
      "properties": {
        "outcome_state": {
          "type": "string",
          "description": "The EXACT expected outcome state from the 13-state taxonomy"
        },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unresolved_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "material_differences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "difference_state": { "type": "string" },
              "asset": { "type": "string" },
              "source_a_value": { "type": "string" },
              "source_b_value": { "type": "string" },
              "variance": { "type": "string" }
            },
            "required": ["difference_state", "asset", "source_a_value", "source_b_value"]
          }
        },
        "processing_result": { "type": "string" },
        "rejection_code": { "type": "string" },
        "authoritative_outcome_created": { "type": "boolean" },
        "receipt_issued": { "type": "boolean" }
      }
    },
    "must_not": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of behaviors or heuristics the engine MUST NOT apply to pass this fixture"
    },
    "references": {
      "type": "object",
      "properties": {
        "semantic_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of SEM-* IDs this fixture proves"
        },
        "acceptance_gates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of AC-* PRD gates this fixture proves"
        }
      },
      "required": ["semantic_rules", "acceptance_gates"]
    }
  },
  "required": [
    "fixture_id",
    "layer",
    "status",
    "semantic_spec_version",
    "evidence_contract_version",
    "description",
    "inputs",
    "expected",
    "must_not",
    "references"
  ]
}
